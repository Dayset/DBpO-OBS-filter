// Foveated Squish
// Squeezes the periphery (X and Y) while the center keeps 1:1 pixels, so a
// fixed stream bitrate is spent on the center. Viewers unfold it with the
// browser extension (extension/), which implements the same mapping.
//
// Per axis: A = (lo, hi, ll, lr): sharp center bounds and periphery lengths,
//           B = (k, p, r, dmin): see src/squish-math.h.
//
// Passes:
//   Squish    source -> squished frame. Each output pixel finds its source
//             position (Newton on the closed-form mapping) and averages the
//             source area it covers (up to 8x8 taps): a proper downscale
//             filter, so the squeezed edges don't shimmer.
//   Unsquish  squished -> source size (what extension viewers see; preview).
//   Clean     optional edge-preserving cleanup outside the center (before Squish).
//   Zone      source with the squeezed area tinted by squeeze strength.
//   Look*     viewer look, Unsquished preview only (never streamed): the same
//             math as the extension (viewer/unsquish-extension/squish.js).
//             LookBlurH/V: NVIDIA Freestyle Details' large Gaussian, at half
//             resolution. LookDetails: HDR toning, sharpen, clarity, bloom.
//             LookCAS: Sharpen+ (approximated with AMD FidelityFX CAS).

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 src_size;
uniform float2 out_size;
uniform float4 ax_a;
uniform float4 ax_b;
uniform float4 ay_a;
uniform float4 ay_b;
uniform float  prefilter; // 1 = area filter when squeezing, 0 = single bilinear tap
uniform float2 align;     // sub-pixel shift so sharp-center pixels land exactly on source pixels
uniform float  clean;     // 0..1 edge-preserving cleanup strength outside the full-quality center
uniform texture2d large;  // look: large blur (half resolution)
uniform float2 blur_step; // look: one blur step in uv (axis * scale / full size)
uniform float4 look;      // look: sharpen, clarity, HDR toning, bloom (0..1)
uniform float  sharp_plus; // look: Sharpen+ (0..1)

sampler_state linearClamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float periph(float t, float len, float k, float p)
{
	return len * (t - k * pow(t, p + 1.0));
}

// Source position (0..1) -> squished position (0..1).
float sq_forward(float x, float4 A, float4 B)
{
	float left_full = periph(1.0, A.z, B.x, B.y);
	float u;
	if (x < A.x)
		u = left_full - periph(saturate((A.x - x) / max(A.z, 1e-6)), A.z, B.x, B.y);
	else if (x <= A.y)
		u = left_full + (x - A.x);
	else
		u = left_full + (A.y - A.x) + periph(saturate((x - A.y) / max(A.w, 1e-6)), A.w, B.x, B.y);
	return u / B.z;
}

// Squished pixels per source pixel.
float sq_density(float x, float4 A, float4 B)
{
	float t = 0.0;
	if (x < A.x)
		t = (A.x - x) / max(A.z, 1e-6);
	else if (x > A.y)
		t = (x - A.y) / max(A.w, 1e-6);
	return 1.0 - (1.0 - B.w) * pow(saturate(t), B.y);
}

// Solve len * (t - k t^(p+1)) = target, t in [0, 1]: Newton kept inside a
// shrinking bracket (bisection when a step leaves it). Plain Newton cycles
// for flat curves with strong squeeze.
float solve_periph(float target, float len, float k, float p)
{
	if (len <= 1e-6)
		return 0.0;
	float lo = 0.0;
	float hi = 1.0;
	float t = saturate(target / len);
	for (int i = 0; i < 20; i++) {
		float f = len * (t - k * pow(t, p + 1.0)) - target;
		if (f > 0.0)
			hi = t;
		else
			lo = t;
		float d = len * (1.0 - k * (p + 1.0) * pow(max(t, 1e-6), p));
		float tn = d > 1e-6 ? t - f / d : 0.5 * (lo + hi);
		if (!(tn >= lo && tn <= hi))
			tn = 0.5 * (lo + hi);
		t = tn;
	}
	return t;
}

// Squished position -> source position, per zone (exact in the center).
float sq_inverse(float u, float4 A, float4 B)
{
	float v = saturate(u) * B.z;
	float left_full = periph(1.0, A.z, B.x, B.y);
	if (v < left_full)
		return saturate(A.x - A.z * solve_periph(left_full - v, A.z, B.x, B.y));
	if (v <= left_full + (A.y - A.x))
		return A.x + (v - left_full);
	return saturate(A.y + A.w * solve_periph(v - left_full - (A.y - A.x), A.w, B.x, B.y));
}

float4 PSSquish(VertData v_in) : TARGET
{
	float2 u = v_in.uv + align;
	float2 s = float2(sq_inverse(u.x, ax_a, ax_b), sq_inverse(u.y, ay_a, ay_b));
	if (prefilter < 0.5)
		return image.SampleLevel(linearClamp, s, 0.0);

	// One output pixel covers 1/d source pixels per axis: average that area.
	float2 foot = float2(1.0 / sq_density(s.x, ax_a, ax_b), 1.0 / sq_density(s.y, ay_a, ay_b));
	int kx = int(clamp(ceil(foot.x), 1.0, 8.0));
	int ky = int(clamp(ceil(foot.y), 1.0, 8.0));
	float4 acc = float4(0.0, 0.0, 0.0, 0.0);
	for (int j = 0; j < ky; j++) {
		for (int i = 0; i < kx; i++) {
			float2 o = (float2((float(i) + 0.5) / float(kx), (float(j) + 0.5) / float(ky)) - 0.5) * foot;
			acc += image.SampleLevel(linearClamp, s + o / src_size, 0.0);
		}
	}
	return acc / float(kx * ky);
}

// Edge-preserving cleanup (bilateral, 7x7) of the area outside the
// full-quality center, before squeezing: removes fine texture and noise
// (grass, grain) the encoder would pay for, keeps strong edges. Strength
// ramps in from the center edge with the squeeze (full where the density
// is 0.85 or lower).
float4 PSClean(VertData v_in) : TARGET
{
	float4 c = image.SampleLevel(linearClamp, v_in.uv, 0.0);
	float d = min(sq_density(v_in.uv.x, ax_a, ax_b), sq_density(v_in.uv.y, ay_a, ay_b));
	float w = saturate((1.0 - d) / 0.15);
	if (w <= 0.0 || clean <= 0.0)
		return c;
	float range = 0.02 + 0.12 * clean;
	float inv_r2 = 1.0 / (2.0 * range * range);
	float4 acc = float4(0.0, 0.0, 0.0, 0.0);
	float wsum = 0.0;
	for (int j = -3; j <= 3; j++) {
		for (int i = -3; i <= 3; i++) {
			float4 s = image.SampleLevel(linearClamp, v_in.uv + float2(float(i), float(j)) / src_size, 0.0);
			float3 dc = s.rgb - c.rgb;
			float k = exp(-float(i * i + j * j) / 8.0 - dot(dc, dc) * inv_r2); // spatial sigma 2 px
			acc += s * k;
			wsum += k;
		}
	}
	return lerp(c, acc / wsum, w);
}

float4 PSUnsquish(VertData v_in) : TARGET
{
	float2 u = float2(sq_forward(v_in.uv.x, ax_a, ax_b), sq_forward(v_in.uv.y, ay_a, ay_b)) - align;
	return image.SampleLevel(linearClamp, u, 0.0);
}

float4 PSZone(VertData v_in) : TARGET
{
	float4 c = image.SampleLevel(linearClamp, v_in.uv, 0.0);
	float d = min(sq_density(v_in.uv.x, ax_a, ax_b), sq_density(v_in.uv.y, ay_a, ay_b));
	float squeeze = saturate((1.0 - d) / 0.98);
	float3 rgb = lerp(c.rgb, float3(1.0, 0.15, 0.1), squeeze * 0.6);
	// Green outline around the full-quality center (2 output pixels wide).
	float2 px = 2.0 / out_size;
	float2 uv = v_in.uv;
	bool inside = uv.x >= ax_a.x && uv.x <= ax_a.y && uv.y >= ay_a.x && uv.y <= ay_a.y;
	bool edge = inside && (uv.x - ax_a.x < px.x || ax_a.y - uv.x < px.x || uv.y - ay_a.x < px.y || ay_a.y - uv.y < px.y);
	if (edge)
		rgb = float3(0.15, 0.85, 0.35);
	return float4(rgb, c.a);
}

technique Squish
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSSquish(v_in);
	}
}

technique Clean
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSClean(v_in);
	}
}

technique Unsquish
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSUnsquish(v_in);
	}
}

technique Zone
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSZone(v_in);
	}
}

// ---------------------------------------------------------------- viewer look
// Details, after NVIDIA Freestyle (details.yfx as ported to ReShade): one
// Gaussian (15 linear-sampled steps per side, taps 2i - 0.5 apart) feeds
// HDR toning, clarity and bloom; an 8-tap box blur feeds sharpen.

float4 PSLookBlur(VertData v_in) : TARGET
{
	float norm = -1.35914091423 / 225.0;
	float4 acc = image.SampleLevel(linearClamp, v_in.uv, 0.0) * 0.5;
	float div = 0.5;
	for (int i = 1; i <= 15; i++) {
		float fi = float(i);
		float o = fi * 2.0 - 0.5;
		float w = exp(fi * fi * norm);
		acc += (image.SampleLevel(linearClamp, v_in.uv + blur_step * o, 0.0) +
			image.SampleLevel(linearClamp, v_in.uv - blur_step * o, 0.0)) * w;
		div += w;
	}
	return acc / (2.0 * div); // normalization as in the original
}

float look_luma(float3 c)
{
	return dot(c, float3(0.299, 0.587, 0.114));
}

float4 PSLookDetails(VertData v_in) : TARGET
{
	float2 px = 1.0 / src_size;
	float4 src = image.SampleLevel(linearClamp, v_in.uv, 0.0);
	float3 color = src.rgb;
	float3 largeb = large.SampleLevel(linearClamp, v_in.uv, 0.0).rgb;
	float3 boxb = (image.SampleLevel(linearClamp, v_in.uv + float2(0.5, 1.5) * px, 0.0).rgb +
			image.SampleLevel(linearClamp, v_in.uv + float2(1.5, -0.5) * px, 0.0).rgb +
			image.SampleLevel(linearClamp, v_in.uv + float2(-0.5, -1.5) * px, 0.0).rgb +
			image.SampleLevel(linearClamp, v_in.uv + float2(-1.5, 0.5) * px, 0.0).rgb) * 1.5 +
		       image.SampleLevel(linearClamp, v_in.uv + float2(2.5, 1.5) * px, 0.0).rgb +
		       image.SampleLevel(linearClamp, v_in.uv + float2(1.5, -2.5) * px, 0.0).rgb +
		       image.SampleLevel(linearClamp, v_in.uv + float2(-2.5, -1.5) * px, 0.0).rgb +
		       image.SampleLevel(linearClamp, v_in.uv + float2(-1.5, 2.5) * px, 0.0).rgb;
	boxb /= 10.0;
	float a = look_luma(color);
	float b = look_luma(largeb);
	float ia = 1.0 / max(a, 1e-6);

	// HDR toning (modified soft light)
	float sa = sqrt(a);
	float hdr = sa * (b > 0.5 ? (2.0 * sa * b - 2.0 * b + 1.0) : sa * (2.0 * a * b - a - 2.0 * b + 2.0));
	color = color * ia * lerp(a, hdr, look.z);

	// Sharpen
	float sh = look_luma(color - boxb);
	float lim = lerp(0.25, 0.6, look.x);
	sh = clamp(sh, -lim, lim);
	color = color * ia * lerp(a, a + sh, look.x);

	// Clarity (modified soft light against the large blur)
	float cl = 0.5 + a - b;
	cl = a > b ? 2.0 * (1.0 - cl) + (2.0 * cl - 1.0) * rsqrt(max(a, 1e-6)) : 2.0 * cl + a * (1.0 - 2.0 * cl);
	color *= lerp(1.0, cl, look.y);

	// Bloom (screen blend of the large blur)
	color = 1.0 - (1.0 - color) * (1.0 - largeb * look.w);
	return float4(saturate(color), src.a);
}

// Sharpen+: contrast-adaptive sharpening (AMD FidelityFX CAS, MIT licence).
float4 PSLookCAS(VertData v_in) : TARGET
{
	float2 px = 1.0 / src_size;
	float2 uv = v_in.uv;
	float3 a = image.SampleLevel(linearClamp, uv + float2(-1.0, -1.0) * px, 0.0).rgb;
	float3 b = image.SampleLevel(linearClamp, uv + float2(0.0, -1.0) * px, 0.0).rgb;
	float3 c = image.SampleLevel(linearClamp, uv + float2(1.0, -1.0) * px, 0.0).rgb;
	float3 d = image.SampleLevel(linearClamp, uv + float2(-1.0, 0.0) * px, 0.0).rgb;
	float4 e4 = image.SampleLevel(linearClamp, uv, 0.0);
	float3 e = e4.rgb;
	float3 f = image.SampleLevel(linearClamp, uv + float2(1.0, 0.0) * px, 0.0).rgb;
	float3 g = image.SampleLevel(linearClamp, uv + float2(-1.0, 1.0) * px, 0.0).rgb;
	float3 h = image.SampleLevel(linearClamp, uv + float2(0.0, 1.0) * px, 0.0).rgb;
	float3 i = image.SampleLevel(linearClamp, uv + float2(1.0, 1.0) * px, 0.0).rgb;
	float3 mn = min(min(min(d, e), min(f, b)), h);
	mn += min(mn, min(min(a, c), min(g, i)));
	float3 mx = max(max(max(d, e), max(f, b)), h);
	mx += max(mx, max(max(a, c), max(g, i)));
	float3 amp = sqrt(saturate(min(mn, 2.0 - mx) / max(mx, 1e-5)));
	float3 w = amp * (-1.0 / lerp(8.0, 5.0, sharp_plus));
	float3 o = ((b + d + f + h) * w + e) / (1.0 + 4.0 * w);
	return float4(saturate(o), e4.a);
}

technique LookBlur
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSLookBlur(v_in);
	}
}

technique LookDetails
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSLookDetails(v_in);
	}
}

technique LookCAS
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSLookCAS(v_in);
	}
}
