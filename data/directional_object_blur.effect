// Directional Object Blur
// Multi-pass motion blur driven by image-space optical flow.
//
// Passes (all pixel shaders; OBS does not expose compute shaders):
//   Downsample   full-res color      -> flow-res color (box filtered)
//   Flow         cur/prev flow-res    -> per-pixel motion vector (block matching)
//   Coherence    motion + color       -> motion smoothed within same-colored regions
//                                        ("per-object" approximation until segmentation lands)
//   StaticMask   cur/prev color       -> per-pixel count of frames unchanged; regions that
//                                        stay identical while the scene moves are UI/HUD
//   UIDilate     static state         -> protected UI mask, grown by a margin
//   FitSample    motion               -> tiny 32-bit copy read back by the CPU, which fits a
//                                        camera-motion model (pan/zoom/rotation/shear)
//   Combine      motion + camera model -> final motion = camera part + object residual,
//                                        each with its own strength
//   JFAInit/Step motion               -> velocity dilation by jump flooding: every pixel
//                                        inside some moving pixel's blur trail learns that
//                                        pixel's blur vector, out to the full blur length
//                                        (log2(length) passes), so blur extends past
//                                        silhouettes instead of stopping at them
//   Blur         full-res color       -> per time slice of the exposure, decide whether a
//                                        moving thing covered this pixel (its own motion
//                                        reaches here, or ours reaches it) and average;
//                                        trailing (real camera) or centered shutter
//   DebugVectors motion               -> color-coded motion field (hue = direction)
//
//   Effects      blurred + motion     -> optional non-directional (area) blur and glow on
//                                        moving objects, and trails (frame feedback)
//   TrailMask    object motion        -> decaying mask of where objects recently were
//   Present      result + original    -> opacity mix
//
// Motion vectors are stored in RG as full-resolution pixels per frame (cur - prev).
// B holds match confidence (0..1), A holds match quality (1 = content found an
// exact match; near 0 when nothing matched, e.g. motion beyond the search range).
//
// Every texture read uses SampleLevel: implicit-LOD Sample() inside variable-length
// loops forces FXC to unroll them, which fails for the larger search windows.

uniform float4x4 ViewProj;

uniform texture2d image;        // pass input (color or motion)
uniform texture2d prev_image;   // previous flow-res frame (Flow pass)
uniform texture2d color_small;  // current flow-res color (Coherence pass)
uniform texture2d motion;       // flow-res motion (Blur / Debug)
uniform texture2d motion_max;   // dilated motion, flow-res: RG = offset to source (flow px), BA = blur vector

uniform float2 texel;           // 1 / size of the texture being sampled at its native res
uniform float2 out_texel;       // 1 / size of the render target
uniform float  flow_scale;      // full-res pixels per flow-res pixel
uniform int    search_radius;   // block-matching search radius, flow-res pixels
uniform float  static_bias;     // how much better a non-zero match must be than "no motion"
uniform int    coherence_radius;
uniform float  color_sigma;     // inverse color tolerance for the coherence pass
uniform int    jfa_step;        // jump-flood step this pass, flow px
uniform float  shutter_phase;   // 0 = trailing blur (real camera), 0.5 = centered
uniform float  tail_fade;       // 0..1, older parts of the exposure fade (comet tail)
uniform float  highlight_boost; // extra weight for bright samples (film-like light streaks)
uniform float3 cam_x;           // camera model: motion.x = dot(cam_x, (1, u - 0.5, v - 0.5))
uniform float3 cam_y;           // camera model: motion.y = dot(cam_y, (1, u - 0.5, v - 0.5))
uniform float  camera_strength; // blur length for camera motion, fraction of per-frame motion
uniform float  object_strength; // blur length for object motion, fraction of per-frame motion
uniform float  object_threshold;// px; residuals smaller than this are treated as camera motion
uniform int    debug_mode;      // 0 final, 1 camera only, 2 object only
uniform int    clear_shape;     // 0 off, 1 oval (frame proportions), 2 square
uniform float  clear_size;      // spot diameter / side as a fraction of frame height (oval: of each axis)
uniform float  clear_feather;   // soft edge width, fraction of the spot size
uniform float  temporal_blend;  // 1 = also use motion out of this frame (look-ahead), 0 = off
uniform float  object_directional; // 1 = objects get directional blur, 0 = area blur only
uniform float  object_trust;    // 0..1, suppresses object detection when motion was unmeasurable
uniform float  dither;          // 1 = jitter blur samples per pixel (hides banding, costs bitrate)
uniform float  area_strength;   // non-directional blur radius per px of object motion
uniform float  glow_amount;
uniform float  glow_radius;     // px
uniform int    trail_mode;      // 0 off, 1 moving objects, 2 everything
uniform float  trail_persistence; // 0..1 share of the previous frame kept per frame
uniform float  history_valid;   // 0 on the first frame after a reset
uniform float  opacity;         // 0..1 mix of effect over the original
uniform texture2d original;     // unprocessed frame (Effects / Present)
uniform texture2d history;      // previous effects output (trails)
uniform texture2d trail_mask;   // previous trail mask, flow-res
uniform texture2d ui_state;     // previous static-region state, flow-res
uniform texture2d ui_mask;      // protected UI mask (dilated), flow-res
uniform float  ui_protect;      // 1 = keep detected UI sharp, 0 = off
uniform float  ui_valid;        // 0 on the first frame after a reset
uniform float  ui_threshold;    // color change that counts as "changed"
uniform float  ui_rise;         // static score gained per unchanged frame
uniform int    ui_margin;       // dilation radius, flow-res px
uniform float  cam_speed_min;   // px/frame: camera motion below this gets no blur
uniform float  cam_speed_full;  // px/frame: full camera blur strength from here
uniform float  cam_curve;       // response exponent between the two (1 = linear)
uniform float  max_radius;      // full-res pixels
uniform float  min_motion;      // full-res pixels; below this nothing blurs
uniform int    sample_count;
uniform float  debug_range;     // full-res pixels mapped to full saturation

sampler_state pointClamp {
	Filter   = Point;
	AddressU = Clamp;
	AddressV = Clamp;
};

sampler_state linearClamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float luma(float3 c)
{
	return dot(c, float3(0.2126, 0.7152, 0.0722));
}

float2 clamp_len(float2 v, float max_len)
{
	float l = length(v);
	return (l > max_len && l > 0.0) ? v * (max_len / l) : v;
}

float2 camera_motion(float2 uv)
{
	float3 p = float3(1.0, uv.x - 0.5, uv.y - 0.5);
	return float2(dot(cam_x, p), dot(cam_y, p));
}

// 0..1, how strongly this spot is protected as static UI.
float ui_at(float2 uv)
{
	return ui_mask.SampleLevel(linearClamp, uv, 0.0).r * ui_protect;
}

// ---------------------------------------------------------------- StaticMask

// image = current flow-res color, prev_image = previous, ui_state = old score.
// A region that stays identical frame after frame (while things around it
// change) is screen-space UI. Any change resets it immediately.
float4 PSStaticMask(VertData v_in) : TARGET
{
	float3 c = image.SampleLevel(pointClamp, v_in.uv, 0.0).rgb;
	float3 p = prev_image.SampleLevel(pointClamp, v_in.uv, 0.0).rgb;
	float3 d = abs(c - p);
	float old = ui_state.SampleLevel(pointClamp, v_in.uv, 0.0).r * ui_valid;
	float changed = step(ui_threshold, max(d.r, max(d.g, d.b)));
	return float4(changed > 0.5 ? 0.0 : min(old + ui_rise, 1.0), 0.0, 0.0, 1.0);
}

// image = static score; output = protected mask grown by ui_margin.
float4 PSUIDilate(VertData v_in) : TARGET
{
	float m = 0.0;
	for (int y = -ui_margin; y <= ui_margin; y++) {
		for (int x = -ui_margin; x <= ui_margin; x++) {
			float s = image.SampleLevel(pointClamp, v_in.uv + float2(x, y) * texel, 0.0).r;
			m = max(m, smoothstep(0.6, 1.0, s));
		}
	}
	return float4(m, 0.0, 0.0, 1.0);
}

// ---------------------------------------------------------------- Downsample

float4 PSDownsample(VertData v_in) : TARGET
{
	// 4 bilinear taps = 16-texel box when the ratio is 4x.
	float2 o = texel * 0.5 * flow_scale * 0.5;
	float4 c = image.SampleLevel(linearClamp, v_in.uv + float2(-o.x, -o.y), 0.0);
	c += image.SampleLevel(linearClamp, v_in.uv + float2( o.x, -o.y), 0.0);
	c += image.SampleLevel(linearClamp, v_in.uv + float2(-o.x,  o.y), 0.0);
	c += image.SampleLevel(linearClamp, v_in.uv + float2( o.x,  o.y), 0.0);
	return c * 0.25;
}

// ---------------------------------------------------------------- Flow

float patch_cost(float2 uv, float2 offset_uv)
{
	// 3x3 patch, sum of absolute luma differences.
	float cost = 0.0;
	for (int py = -1; py <= 1; py++) {
		for (int px = -1; px <= 1; px++) {
			float2 k = float2(px, py) * texel;
			float a = luma(image.SampleLevel(pointClamp, uv + k, 0.0).rgb);
			float b = luma(prev_image.SampleLevel(pointClamp, uv + k + offset_uv, 0.0).rgb);
			cost += abs(a - b);
		}
	}
	return cost;
}

float4 PSFlow(VertData v_in) : TARGET
{
	float zero_cost = patch_cost(v_in.uv, float2(0.0, 0.0));
	float best_cost = zero_cost;
	float2 best = float2(0.0, 0.0);
	float worst_cost = zero_cost;

	for (int y = -search_radius; y <= search_radius; y++) {
		for (int x = -search_radius; x <= search_radius; x++) {
			float2 o = float2(x, y);
			// Small penalty for long vectors keeps flat areas from wandering.
			float c = patch_cost(v_in.uv, o * texel) + length(o) * 0.004;
			worst_cost = max(worst_cost, c);
			if (c < best_cost) {
				best_cost = c;
				best = o;
			}
		}
	}

	// Treat as static unless moving is clearly better than staying put.
	if (zero_cost - best_cost < static_bias)
		best = float2(0.0, 0.0);

	// Confidence: how distinct the best match is (texture-less areas score low).
	float confidence = saturate((worst_cost - best_cost) / max(worst_cost, 1e-4));

	// Content at uv was at uv + best*texel in the previous frame, so it moved by -best.
	float2 v = -best * flow_scale;
	// Absolute match quality: a 3x3 patch that truly reappears costs ~0.
	float quality = saturate(1.0 - best_cost / 0.6);
	return float4(v, confidence, quality);
}

// ---------------------------------------------------------------- Coherence

float4 PSCoherence(VertData v_in) : TARGET
{
	float3 center = color_small.SampleLevel(pointClamp, v_in.uv, 0.0).rgb;
	float2 sum = float2(0.0, 0.0);
	float wsum = 0.0;
	float csum = 0.0;
	float qsum = 0.0;

	for (int y = -coherence_radius; y <= coherence_radius; y++) {
		for (int x = -coherence_radius; x <= coherence_radius; x++) {
			float2 uv = v_in.uv + float2(x, y) * texel;
			float4 m = image.SampleLevel(pointClamp, uv, 0.0);
			float3 c = color_small.SampleLevel(pointClamp, uv, 0.0).rgb;
			float3 d = c - center;
			float w = exp(-dot(d, d) * color_sigma) * (0.05 + m.b);
			sum += m.rg * w;
			csum += m.b * w;
			qsum += m.a * w;
			wsum += w;
		}
	}

	float2 v = sum / max(wsum, 1e-5);
	return float4(v, csum / max(wsum, 1e-5), qsum / max(wsum, 1e-5));
}

// ---------------------------------------------------------------- FitSample

// Point-samples the coherent motion field into a tiny float32 target that the
// CPU reads back to fit the camera model. RG = motion (px), B = confidence.
float4 PSFitSample(VertData v_in) : TARGET
{
	float4 m = image.SampleLevel(pointClamp, v_in.uv, 0.0);
	m.b *= 1.0 - ui_at(v_in.uv); // UI says nothing about the camera
	return m;
}

// ---------------------------------------------------------------- Combine

// RG = final motion (strengths applied), BA = object-only motion (for debug).
// image = motion into this frame; with look-ahead, motion = motion out of it.
// Blending both, weighted by confidence, centers the blur on the frame and
// lets whichever side sees an occluded region supply its motion.
float4 PSCombine(VertData v_in) : TARGET
{
	float4 m_in = image.SampleLevel(pointClamp, v_in.uv, 0.0);
	float4 m_out = motion.SampleLevel(pointClamp, v_in.uv, 0.0);
	float w_in = 0.05 + m_in.b;
	float w_out = (0.05 + m_out.b) * temporal_blend;
	float4 m;
	m.rg = (m_in.rg * w_in + m_out.rg * w_out) / (w_in + w_out);
	m.b = max(m_in.b, m_out.b * temporal_blend);
	m.a = 1.0;
	float2 cam = camera_motion(v_in.uv);

	// What the camera model doesn't explain, if we trust the measurement.
	float2 residual = m.rg - cam;
	float conf = saturate(m.b * 3.0);
	float is_object = smoothstep(object_threshold, object_threshold * 2.0 + 0.5, length(residual)) * conf * object_trust;
	float2 obj = residual * is_object;

	// Speed -> blur response for camera motion: nothing below cam_speed_min,
	// full strength from cam_speed_full, shaped by cam_curve in between.
	float speed = length(cam);
	float ramp = saturate((speed - cam_speed_min) / max(cam_speed_full - cam_speed_min, 0.01));
	float response = pow(ramp, max(cam_curve, 0.05));

	float2 final_motion = clamp_len(cam * (camera_strength * response) + obj * (object_strength * object_directional), max_radius);
	float keep_ui = 1.0 - ui_at(v_in.uv);
	final_motion *= keep_ui;
	obj *= keep_ui;
	// BA = raw object motion: drives debug view, area blur, glow and trails.
	return float4(final_motion, obj);
}

// ---------------------------------------------------------------- Velocity dilation (JFA)

// Does a pixel moving with blur vector `vel` (full-res px), located at offset
// `d` (flow px) from here, smear over this pixel? The gather at p samples
// p + vel * t for t in [-shutter_phase, 1 - shutter_phase], so the source
// covers p when d = vel * t for such a t (within a pixel sideways).
bool trail_covers(float2 d, float2 vel)
{
	float2 vf = vel / flow_scale;
	float l2 = dot(vf, vf);
	if (l2 < 1e-4)
		return dot(d, d) < 0.25;
	float t = dot(d, vf) / l2;
	float margin = 0.75 / sqrt(l2);
	if (t < -shutter_phase - margin || t > 1.0 - shutter_phase + margin)
		return false;
	float2 side = d - vf * t;
	return dot(side, side) <= 1.0;
}

// image = combined motion. Moving pixels become seeds of themselves.
float4 PSJFAInit(VertData v_in) : TARGET
{
	float2 v = image.SampleLevel(pointClamp, v_in.uv, 0.0).rg;
	if (length(v) < min_motion)
		return float4(0.0, 0.0, 0.0, 0.0);
	return float4(0.0, 0.0, v);
}

// image = previous step. Look at 9 points jfa_step apart and keep the
// fastest source whose trail covers this pixel.
float4 PSJFAStep(VertData v_in) : TARGET
{
	float4 best = image.SampleLevel(pointClamp, v_in.uv, 0.0);
	float best_speed = dot(best.ba, best.ba) > 0.0 && trail_covers(best.rg, best.ba) ? length(best.ba) : 0.0;
	if (best_speed <= 0.0)
		best = float4(0.0, 0.0, 0.0, 0.0);

	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			if (x == 0 && y == 0)
				continue;
			float2 o = float2(x, y) * float(jfa_step);
			float2 uv = v_in.uv + o * texel;
			if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0)
				continue;
			float4 c = image.SampleLevel(pointClamp, uv, 0.0);
			float speed = length(c.ba);
			if (speed <= best_speed)
				continue;
			float2 d = o + c.rg; // source position relative to this pixel
			if (trail_covers(d, c.ba)) {
				best = float4(d, c.ba);
				best_speed = speed;
			}
		}
	}
	return best;
}

// ---------------------------------------------------------------- Blur

// 1 inside the center clear spot (no blur), 0 outside, soft in between.
float clear_mask(float2 uv)
{
	if (clear_shape == 0 || clear_size <= 0.0)
		return 0.0;
	float2 d = uv - 0.5;
	float dist;
	if (clear_shape == 1) {
		// Oval: the frame's own proportions, so 16:9 gives a wide ellipse.
		dist = length(d) / (0.5 * clear_size);
	} else {
		// Square in pixels: measure x in units of frame height.
		float aspect = out_texel.y / out_texel.x;
		float2 dp = float2(d.x * aspect, d.y);
		dist = max(abs(dp.x), abs(dp.y)) / (0.5 * clear_size);
	}
	return 1.0 - smoothstep(1.0, 1.0 + max(clear_feather, 1e-4), dist);
}

// Soft 1-px edge: 1 when `reach` covers `dist`, 0 when it doesn't.
float covered(float dist, float reach)
{
	return reach > 0.25 ? saturate(reach - dist + 0.5) : 0.0;
}

// Bright samples weigh more, so lights keep their intensity when smeared
// (film keeps highlights; plain averaging of SDR colors dims them).
float highlight_weight(float3 c)
{
	return 1.0 + highlight_boost * smoothstep(0.6, 1.0, luma(c));
}

float4 PSBlur(VertData v_in) : TARGET
{
	float4 center = image.SampleLevel(pointClamp, v_in.uv, 0.0);

	float keep = max(clear_mask(v_in.uv), ui_at(v_in.uv));
	if (keep >= 0.999)
		return center;

	// Dominant blur vector reaching this pixel (dilated), and our own.
	float2 vc = motion.SampleLevel(linearClamp, v_in.uv, 0.0).rg;
	float2 vn = motion_max.SampleLevel(pointClamp, v_in.uv, 0.0).ba;
	if (dot(vc, vc) > dot(vn, vn))
		vn = vc;
	float vn_len = length(vn);
	if (vn_len < min_motion)
		return center;
	float2 dir = vn / vn_len;

	// How far along `dir` our own content travels during the exposure,
	// ahead (past part) and behind (future part, centered shutter only).
	float own = max(dot(vc, dir), 0.0);
	float own_ahead = own * (1.0 - shutter_phase);
	float own_behind = own * shutter_phase;

	float hc = highlight_weight(center.rgb);
	float2 px = v_in.uv / out_texel;
	float jitter = lerp(0.5, frac(52.9829189 * frac(dot(px, float2(0.06711056, 0.00583715)))), dither);

	float4 acc = float4(0.0, 0.0, 0.0, 0.0);
	float wacc = 0.0;
	float n = max(float(sample_count), 1.0);
	for (int i = 0; i < sample_count; i++) {
		// One time slice: the content now at p + vn * t was over p at that
		// moment if its own motion reaches back here (or ours reaches it).
		float t = lerp(-shutter_phase, 1.0 - shutter_phase, (float(i) + jitter) / n);
		float dist = abs(t) * vn_len;
		float2 uv = v_in.uv + vn * t * out_texel;

		float2 vs = motion.SampleLevel(linearClamp, uv, 0.0).rg;
		float reach = max(dot(vs, dir), 0.0) * (t >= 0.0 ? 1.0 - shutter_phase : shutter_phase);
		float c = max(covered(dist, reach), covered(dist, t >= 0.0 ? own_ahead : own_behind));
		c *= 1.0 - ui_at(uv); // never pull UI colors into the scene

		// Older slices fade for a comet-like tail.
		float age = t >= 0.0 ? t / max(1.0 - shutter_phase, 1e-3) : 0.0;
		float slice = 1.0 - tail_fade * age;

		float4 cs = image.SampleLevel(linearClamp, uv, 0.0);
		float hs = highlight_weight(cs.rgb);
		acc += slice * (c * hs * cs + (1.0 - c) * hc * center);
		wacc += slice * (c * hs + (1.0 - c) * hc);
	}

	return lerp(acc / max(wacc, 1e-5), center, keep);
}

// ---------------------------------------------------------------- Effects

float object_mask(float2 uv)
{
	float s = length(motion.SampleLevel(linearClamp, uv, 0.0).ba);
	return smoothstep(min_motion, min_motion + 3.0, s);
}

// Golden-angle spiral: evenly fills a unit disk for any sample count.
float2 spiral(int i, float n)
{
	float t = (float(i) + 0.5) / n;
	float a = float(i) * 2.39996323;
	return sqrt(t) * float2(cos(a), sin(a));
}

// image = directionally blurred frame, motion = combined motion (BA = objects).
float4 PSEffects(VertData v_in) : TARGET
{
	float4 base = image.SampleLevel(pointClamp, v_in.uv, 0.0);
	float keep = max(clear_mask(v_in.uv), ui_at(v_in.uv));
	if (keep >= 0.999)
		return base;

	float4 c = base;
	float2 aspect_px = out_texel; // uv per px

	// Non-directional (area) blur, radius from the object's own speed.
	if (area_strength > 0.0) {
		float speed = length(motion.SampleLevel(linearClamp, v_in.uv, 0.0).ba);
		float r = min(speed * area_strength, max_radius);
		if (r > 0.75) {
			float n = clamp(float(sample_count), 8.0, 48.0);
			float4 sum = base;
			for (int i = 0; i < int(n); i++)
				sum += image.SampleLevel(linearClamp, v_in.uv + spiral(i, n) * r * aspect_px, 0.0);
			c = sum / (n + 1.0);
		}
	}

	// Glow: light from moving objects spreads outward (weighted at the
	// sample, so the halo extends past the object's silhouette).
	if (glow_amount > 0.0) {
		float3 halo = float3(0.0, 0.0, 0.0);
		for (int i = 0; i < 16; i++) {
			float2 uv = v_in.uv + spiral(i, 16.0) * glow_radius * aspect_px;
			halo += image.SampleLevel(linearClamp, uv, 0.0).rgb * object_mask(uv);
		}
		halo *= glow_amount / 16.0;
		c.rgb = 1.0 - (1.0 - c.rgb) * (1.0 - saturate(halo)); // screen blend
	}

	// Trails: keep part of the previous output where objects recently were.
	if (trail_mode > 0 && history_valid > 0.5) {
		float w = trail_persistence;
		if (trail_mode == 1)
			w *= trail_mask.SampleLevel(linearClamp, v_in.uv, 0.0).r;
		c = lerp(c, history.SampleLevel(pointClamp, v_in.uv, 0.0), w);
	}

	return lerp(c, base, keep);
}

// image unused; motion = combined motion, trail_mask = previous mask.
float4 PSTrailMask(VertData v_in) : TARGET
{
	float now = object_mask(v_in.uv);
	float old = trail_mask.SampleLevel(linearClamp, v_in.uv, 0.0).r * history_valid;
	return float4(max(now, old * trail_persistence), 0.0, 0.0, 1.0);
}

float4 PSPresent(VertData v_in) : TARGET
{
	float4 o = original.SampleLevel(pointClamp, v_in.uv, 0.0);
	float4 e = image.SampleLevel(pointClamp, v_in.uv, 0.0);
	return lerp(o, e, opacity);
}

// ---------------------------------------------------------------- Debug

float3 hue_to_rgb(float h)
{
	float r = abs(h * 6.0 - 3.0) - 1.0;
	float g = 2.0 - abs(h * 6.0 - 2.0);
	float b = 2.0 - abs(h * 6.0 - 4.0);
	return saturate(float3(r, g, b));
}

float4 PSDebugVectors(VertData v_in) : TARGET
{
	if (debug_mode == 3) {
		// UI mask: protected regions in red over the dimmed frame.
		float3 img = image.SampleLevel(linearClamp, v_in.uv, 0.0).rgb;
		float u = ui_at(v_in.uv);
		return float4(lerp(img * 0.45, float3(1.0, 0.15, 0.1), u * 0.65), 1.0);
	}

	float4 m = motion.SampleLevel(linearClamp, v_in.uv, 0.0);
	float2 v = m.rg;
	if (debug_mode == 1)
		v = camera_motion(v_in.uv);
	else if (debug_mode == 4)
		v = motion_max.SampleLevel(pointClamp, v_in.uv, 0.0).ba;
	else if (debug_mode == 2)
		v = m.ba;
	float mag = saturate(length(v) / max(debug_range, 1e-3));
	float hue = atan2(v.y, v.x) / 6.28318530718 + 0.5;
	float3 col = lerp(float3(0.0, 0.0, 0.0), hue_to_rgb(hue), mag);
	col *= 1.0 - clear_mask(v_in.uv); // show the clear spot as an unblurred hole
	float3 base = image.SampleLevel(linearClamp, v_in.uv, 0.0).rgb * 0.25;
	return float4(base + col, 1.0);
}

// ---------------------------------------------------------------- Techniques

technique Downsample
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDownsample(v_in);
	}
}

technique Flow
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSFlow(v_in);
	}
}

