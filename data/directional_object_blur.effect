// Directional Object Blur
// Multi-pass motion blur driven by image-space optical flow.
//
// Passes (all pixel shaders; OBS does not expose compute shaders):
//   Downsample   full-res color      -> flow-res color (box filtered)
//   Flow         cur/prev flow-res    -> per-pixel motion vector (block matching)
//   Coherence    motion + color       -> motion smoothed within same-colored regions
//                                        ("per-object" approximation until segmentation lands)
//   FitSample    motion               -> tiny 32-bit copy read back by the CPU, which fits a
//                                        camera-motion model (pan/zoom/rotation/shear)
//   Combine      motion + camera model -> final motion = camera part + object residual,
//                                        each with its own strength
//   NeighborMax  motion               -> largest motion in the neighborhood, so blur can
//                                        smear past an object's silhouette
//   Blur         full-res color       -> gather along the dominant motion, weighted by
//                                        whether each sample's own motion reaches this pixel
//                                        (after McGuire et al., "A Reconstruction Filter for
//                                        Plausible Motion Blur", I3D 2012, without depth)
//   DebugVectors motion               -> color-coded motion field (hue = direction)
//
// Motion vectors are stored in RG as full-resolution pixels per frame (cur - prev).
// B holds match confidence (0..1).
//
// Every texture read uses SampleLevel: implicit-LOD Sample() inside variable-length
// loops forces FXC to unroll them, which fails for the larger search windows.

uniform float4x4 ViewProj;

uniform texture2d image;        // pass input (color or motion)
uniform texture2d prev_image;   // previous flow-res frame (Flow pass)
uniform texture2d color_small;  // current flow-res color (Coherence pass)
uniform texture2d motion;       // flow-res motion (Blur / Debug)
uniform texture2d motion_max;   // flow-res neighbor-max motion (Blur)

uniform float2 texel;           // 1 / size of the texture being sampled at its native res
uniform float2 out_texel;       // 1 / size of the render target
uniform float  flow_scale;      // full-res pixels per flow-res pixel
uniform int    search_radius;   // block-matching search radius, flow-res pixels
uniform float  static_bias;     // how much better a non-zero match must be than "no motion"
uniform int    coherence_radius;
uniform float  color_sigma;     // inverse color tolerance for the coherence pass
uniform int    neighbor_radius;
uniform float3 cam_x;           // camera model: motion.x = dot(cam_x, (1, u - 0.5, v - 0.5))
uniform float3 cam_y;           // camera model: motion.y = dot(cam_y, (1, u - 0.5, v - 0.5))
uniform float  camera_strength; // blur length for camera motion, fraction of per-frame motion
uniform float  object_strength; // blur length for object motion, fraction of per-frame motion
uniform float  object_threshold;// px; residuals smaller than this are treated as camera motion
uniform int    debug_mode;      // 0 final, 1 camera only, 2 object only
uniform int    clear_shape;     // 0 off, 1 oval (frame proportions), 2 square
uniform float  clear_size;      // spot diameter / side as a fraction of frame height (oval: of each axis)
uniform float  clear_feather;   // soft edge width, fraction of the spot size
uniform float  temporal_blend;  // 1 = also use motion out of this frame (look-ahead), 0 = off
uniform float  max_radius;      // full-res pixels
uniform float  min_motion;      // full-res pixels; below this nothing blurs
uniform int    sample_count;
uniform float  debug_range;     // full-res pixels mapped to full saturation

sampler_state pointClamp {
	Filter   = Point;
	AddressU = Clamp;
	AddressV = Clamp;
};

sampler_state linearClamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float luma(float3 c)
{
	return dot(c, float3(0.2126, 0.7152, 0.0722));
}

float2 clamp_len(float2 v, float max_len)
{
	float l = length(v);
	return (l > max_len && l > 0.0) ? v * (max_len / l) : v;
}

float2 camera_motion(float2 uv)
{
	float3 p = float3(1.0, uv.x - 0.5, uv.y - 0.5);
	return float2(dot(cam_x, p), dot(cam_y, p));
}

// ---------------------------------------------------------------- Downsample

float4 PSDownsample(VertData v_in) : TARGET
{
	// 4 bilinear taps = 16-texel box when the ratio is 4x.
	float2 o = texel * 0.5 * flow_scale * 0.5;
	float4 c = image.SampleLevel(linearClamp, v_in.uv + float2(-o.x, -o.y), 0.0);
	c += image.SampleLevel(linearClamp, v_in.uv + float2( o.x, -o.y), 0.0);
	c += image.SampleLevel(linearClamp, v_in.uv + float2(-o.x,  o.y), 0.0);
	c += image.SampleLevel(linearClamp, v_in.uv + float2( o.x,  o.y), 0.0);
	return c * 0.25;
}

// ---------------------------------------------------------------- Flow

float patch_cost(float2 uv, float2 offset_uv)
{
	// 3x3 patch, sum of absolute luma differences.
	float cost = 0.0;
	for (int py = -1; py <= 1; py++) {
		for (int px = -1; px <= 1; px++) {
			float2 k = float2(px, py) * texel;
			float a = luma(image.SampleLevel(pointClamp, uv + k, 0.0).rgb);
			float b = luma(prev_image.SampleLevel(pointClamp, uv + k + offset_uv, 0.0).rgb);
			cost += abs(a - b);
		}
	}
	return cost;
}

float4 PSFlow(VertData v_in) : TARGET
{
	float zero_cost = patch_cost(v_in.uv, float2(0.0, 0.0));
	float best_cost = zero_cost;
	float2 best = float2(0.0, 0.0);
	float worst_cost = zero_cost;

	for (int y = -search_radius; y <= search_radius; y++) {
		for (int x = -search_radius; x <= search_radius; x++) {
			float2 o = float2(x, y);
			// Small penalty for long vectors keeps flat areas from wandering.
			float c = patch_cost(v_in.uv, o * texel) + length(o) * 0.004;
			worst_cost = max(worst_cost, c);
			if (c < best_cost) {
				best_cost = c;
				best = o;
			}
		}
	}

	// Treat as static unless moving is clearly better than staying put.
	if (zero_cost - best_cost < static_bias)
		best = float2(0.0, 0.0);

	// Confidence: how distinct the best match is (texture-less areas score low).
	float confidence = saturate((worst_cost - best_cost) / max(worst_cost, 1e-4));

	// Content at uv was at uv + best*texel in the previous frame, so it moved by -best.
	float2 v = -best * flow_scale;
	return float4(v, confidence, 1.0);
}

// ---------------------------------------------------------------- Coherence

float4 PSCoherence(VertData v_in) : TARGET
{
	float3 center = color_small.SampleLevel(pointClamp, v_in.uv, 0.0).rgb;
	float2 sum = float2(0.0, 0.0);
	float wsum = 0.0;
	float csum = 0.0;

	for (int y = -coherence_radius; y <= coherence_radius; y++) {
		for (int x = -coherence_radius; x <= coherence_radius; x++) {
			float2 uv = v_in.uv + float2(x, y) * texel;
			float4 m = image.SampleLevel(pointClamp, uv, 0.0);
			float3 c = color_small.SampleLevel(pointClamp, uv, 0.0).rgb;
			float3 d = c - center;
			float w = exp(-dot(d, d) * color_sigma) * (0.05 + m.b);
			sum += m.rg * w;
			csum += m.b * w;
			wsum += w;
		}
	}

	float2 v = sum / max(wsum, 1e-5);
	return float4(v, csum / max(wsum, 1e-5), 1.0);
}

// ---------------------------------------------------------------- FitSample

// Point-samples the coherent motion field into a tiny float32 target that the
// CPU reads back to fit the camera model. RG = motion (px), B = confidence.
float4 PSFitSample(VertData v_in) : TARGET
{
	return image.SampleLevel(pointClamp, v_in.uv, 0.0);
}

// ---------------------------------------------------------------- Combine

// RG = final motion (strengths applied), BA = object-only motion (for debug).
// image = motion into this frame; with look-ahead, motion = motion out of it.
// Blending both, weighted by confidence, centers the blur on the frame and
// lets whichever side sees an occluded region supply its motion.
float4 PSCombine(VertData v_in) : TARGET
{
	float4 m_in = image.SampleLevel(pointClamp, v_in.uv, 0.0);
	float4 m_out = motion.SampleLevel(pointClamp, v_in.uv, 0.0);
	float w_in = 0.05 + m_in.b;
	float w_out = (0.05 + m_out.b) * temporal_blend;
	float4 m;
	m.rg = (m_in.rg * w_in + m_out.rg * w_out) / (w_in + w_out);
	m.b = max(m_in.b, m_out.b * temporal_blend);
	m.a = 1.0;
	float2 cam = camera_motion(v_in.uv);

	// What the camera model doesn't explain, if we trust the measurement.
	float2 residual = m.rg - cam;
	float conf = saturate(m.b * 3.0);
	float is_object = smoothstep(object_threshold, object_threshold * 2.0 + 0.5, length(residual)) * conf;
	float2 obj = residual * is_object;

	float2 final_motion = clamp_len(cam * camera_strength + obj * object_strength, max_radius);
	return float4(final_motion, obj * object_strength);
}

// ---------------------------------------------------------------- NeighborMax

float4 PSNeighborMax(VertData v_in) : TARGET
{
	float2 best = float2(0.0, 0.0);
	float best_len = 0.0;

	for (int y = -neighbor_radius; y <= neighbor_radius; y++) {
		for (int x = -neighbor_radius; x <= neighbor_radius; x++) {
			float2 m = image.SampleLevel(pointClamp, v_in.uv + float2(x, y) * texel, 0.0).rg;
			float l = dot(m, m);
			if (l > best_len) {
				best_len = l;
				best = m;
			}
		}
	}
	return float4(best, 0.0, 1.0);
}

// ---------------------------------------------------------------- Blur

float cone(float dist, float speed)
{
	return saturate(1.0 - dist / max(speed, 1e-3));
}

// 1 inside the center clear spot (no blur), 0 outside, soft in between.
float clear_mask(float2 uv)
{
	if (clear_shape == 0 || clear_size <= 0.0)
		return 0.0;
	float2 d = uv - 0.5;
	float dist;
	if (clear_shape == 1) {
		// Oval: the frame's own proportions, so 16:9 gives a wide ellipse.
		dist = length(d) / (0.5 * clear_size);
	} else {
		// Square in pixels: measure x in units of frame height.
		float aspect = out_texel.y / out_texel.x;
		float2 dp = float2(d.x * aspect, d.y);
		dist = max(abs(dp.x), abs(dp.y)) / (0.5 * clear_size);
	}
	return 1.0 - smoothstep(1.0, 1.0 + max(clear_feather, 1e-4), dist);
}

float4 PSBlur(VertData v_in) : TARGET
{
	float4 center = image.SampleLevel(pointClamp, v_in.uv, 0.0);

	float keep = clear_mask(v_in.uv);
	if (keep >= 0.999)
		return center;

	float2 vn = motion_max.SampleLevel(pointClamp, v_in.uv, 0.0).rg;
	float vn_len = length(vn);
	if (vn_len < min_motion)
		return center;

	float2 vc = motion.SampleLevel(linearClamp, v_in.uv, 0.0).rg;
	float vc_len = max(length(vc), 0.5);

	// The center sample's weight matches the McGuire normalization.
	float wc = 1.0 / vc_len;
	float4 sum = center * wc;
	float wsum = wc;

	// Per-pixel offset (interleaved gradient noise) turns banding on long
	// blurs into fine grain.
	float2 px = v_in.uv / out_texel;
	float jitter = frac(52.9829189 * frac(dot(px, float2(0.06711056, 0.00583715))));

	float n = max(float(sample_count), 1.0);
	for (int i = 0; i < sample_count; i++) {
		float t = lerp(-0.5, 0.5, (float(i) + jitter) / n);
		float dist = abs(t) * vn_len;
		float2 uv = v_in.uv + vn * t * out_texel;

		float2 vs = motion.SampleLevel(linearClamp, uv, 0.0).rg;
		float vs_len = max(length(vs), 0.5);

		// Sample smears over us if its own motion reaches this far,
		// and we smear over it if ours does. No depth, so both count.
		float w = cone(dist, vs_len) / vs_len + cone(dist, vc_len) / vc_len;

		sum += image.SampleLevel(linearClamp, uv, 0.0) * w;
		wsum += w;
	}

	return lerp(sum / max(wsum, 1e-5), center, keep);
}

// ---------------------------------------------------------------- Debug

float3 hue_to_rgb(float h)
{
	float r = abs(h * 6.0 - 3.0) - 1.0;
	float g = 2.0 - abs(h * 6.0 - 2.0);
	float b = 2.0 - abs(h * 6.0 - 4.0);
	return saturate(float3(r, g, b));
}

float4 PSDebugVectors(VertData v_in) : TARGET
{
	float4 m = motion.SampleLevel(linearClamp, v_in.uv, 0.0);
	float2 v = m.rg;
	if (debug_mode == 1)
		v = camera_motion(v_in.uv);
	else if (debug_mode == 2)
		v = m.ba;
	float mag = saturate(length(v) / max(debug_range, 1e-3));
	float hue = atan2(v.y, v.x) / 6.28318530718 + 0.5;
	float3 col = lerp(float3(0.0, 0.0, 0.0), hue_to_rgb(hue), mag);
	col *= 1.0 - clear_mask(v_in.uv); // show the clear spot as an unblurred hole
	float3 base = image.SampleLevel(linearClamp, v_in.uv, 0.0).rgb * 0.25;
	return float4(base + col, 1.0);
}

// ---------------------------------------------------------------- Techniques

technique Downsample
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDownsample(v_in);
	}
}

technique Flow
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSFlow(v_in);
	}
}

technique Coherence
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSCoherence(v_in);
	}
}

technique FitSample
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSFitSample(v_in);
	}
}

technique Combine
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSCombine(v_in);
	}
}

technique NeighborMax
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSNeighborMax(v_in);
	}
}

technique Blur
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBlur(v_in);
	}
}

technique DebugVectors
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDebugVectors(v_in);
	}
}
